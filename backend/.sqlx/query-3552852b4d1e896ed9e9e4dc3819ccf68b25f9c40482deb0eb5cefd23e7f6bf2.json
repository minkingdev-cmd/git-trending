  "query": "SELECT s.stars, s.forks, s.watchers, s.board AS \"board!\"\n               FROM snapshots s\n               JOIN repos r ON r.id = s.repo_id\n               WHERE r.full_name = 'tracked/only' AND s.snapshot_date = $1\n               ORDER BY s.board",
