DATABASE_URL=postgres://postgres@localhost:5432/ghtrending
DATABASE_URL_TEST=postgres://postgres@localhost:5432/ghtrending_test
DATABASE_URL_TEST_COLLECTOR=postgres://postgres@localhost:5432/ghtrending_test_collector
DATABASE_URL_TEST_API=postgres://postgres@localhost:5432/ghtrending_test_api
JWT_SECRET=change-me
# Optional AES-256 key for per-user GitHub PAT storage (64 hex chars or base64 of 32 bytes).
# If unset, derived as SHA-256(JWT_SECRET || "ght-github-token-v1").
# TOKEN_ENCRYPTION_KEY=
# Shared fallback for discover Search + collector/enrich (not user PATs).
GITHUB_TOKEN=
# Discover rate limits (requests/minute before calling GitHub Search).
DISCOVER_RATE_LIMIT_PER_MIN=20
DISCOVER_RATE_LIMIT_PER_USER_PER_MIN=10
DISCOVER_RATE_LIMIT_PER_USER_WITH_TOKEN_PER_MIN=25
LANGUAGES=
COLLECT_TIME=09:00
COOKIE_SECURE=false
